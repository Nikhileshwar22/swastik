# ─────────────────────────────────────────────────────────────────────────────
# Swastik — AI Interior & Architectural Visualizer
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key — required for real AI image generation.
# Leave empty to run in Demo Mode (uses bundled sample images).
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Server port (default: 5000)
PORT=5000

# Node environment — set to "production" when deploying
NODE_ENV=development
